---
import '@fontsource/playfair-display';
import '@fontsource/poppins';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Transform your raw Baluchi dresses into unique, beautifully designed garments" } = Astro.props;

// Social Media Meta Data
const socialImage = '/social-preview.jpg';
const siteUrl = 'https://baluchidoch.com';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
    <title>{title} | Baluchi Doch</title>

    <!-- SEO Meta Tags -->
    <link rel="canonical" href={siteUrl + Astro.url.pathname} />
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="Baluchi dress, custom tailoring, Pakistani fashion, traditional clothing, dress customization, Punjab tailor" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={`${title} | Baluchi Doch`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:url" content={siteUrl + Astro.url.pathname} />
    <meta property="og:type" content="website" />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Baluchi Doch`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <!-- Schema.org Markup -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Baluchi Doch",
        "image": "${socialImage}",
        "description": "${description}",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Khan Bela",
          "addressLocality": "Teh. Liquat Pur",
          "addressRegion": "Punjab",
          "addressCountry": "Pakistan"
        },
        "url": "${siteUrl}",
        "sameAs": [
          "https://www.tiktok.com/@blochidoch786",
          "https://www.instagram.com/balochi3064"
        ]
      }
    </script>
  </head>
  <body class="bg-background font-sans">
    <Header />
    <slot />
    <Footer />
    <script is:inline src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <script is:inline>
      AOS.init({
        duration: 800,
        once: false,
        mirror: true,
      });
    </script>
  </body>
</html>