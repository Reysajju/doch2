---
import Layout from '../layouts/Layout.astro';

const portfolioItems = [
  {
    title: 'Traditional Baluchi Dress',
    description: 'Custom embroidery with traditional patterns',
    image: '/imgs/baluchi_doch (1).jpeg'
  },
  {
    title: 'Modern Fusion Design',
    description: 'Contemporary take on classic Baluchi style',
    image: '/imgs/baluchi_doch (2).jpeg'
  },
  {
    title: 'Heritage Collection',
    description: 'Preserving traditional aesthetics',
    image: '/imgs/baluchi_doch (3).jpeg'
  },
  {
    title: 'Elegant Designs',
    description: 'Exquisite craftsmanship in every detail',
    image: '/imgs/baluchi_doch (4).jpeg'
  },
  {
    title: 'Custom Creations',
    description: 'Personalized to your style',
    image: '/imgs/baluchi_doch (5).jpeg'
  },
  {
    title: 'Modern Elegance',
    description: 'Contemporary interpretations of classic designs',
    image: '/imgs/baluchi_doch (6).jpeg'
  }
];
---

<Layout title="Portfolio">
  <main class="container mx-auto px-4 py-20">
    <h1 class="font-display text-4xl text-primary text-center mb-12">Our Portfolio</h1>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {portfolioItems.map(item => (
        <div class="bg-white rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow duration-300" data-aos="fade-up">
          <img src={item.image} alt={item.title} class="w-full h-64 object-cover" />
          <div class="p-6">
            <h3 class="font-display text-xl text-primary mb-2">{item.title}</h3>
            <p class="text-gray-700">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </main>
</Layout>